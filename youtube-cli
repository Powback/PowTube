#!/usr/bin/env bash
# youtube-cli wrapper — delegates TV commands to the iSponsorBlockTV control API (port 7654)
#
# URL resolution (in order):
#   1. ISPTV_API_URL env var — explicit override
#   2. Docker bridge gateway:7654 — detected dynamically (works from host and containers)
#
# Override: export ISPTV_API_URL=http://other-host:7654

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "${ISPTV_API_URL}" ]; then
  if [ -f /.dockerenv ]; then
    # Inside a container — get default gateway from kernel routing table
    GATEWAY=$(awk 'NR>1 && $2=="00000000" {
      h=$3; ip="";
      for(i=7;i>=1;i-=2) ip=ip (length(ip)?".":"") int("0x" substr(h,i,2));
      print ip; exit
    }' /proc/net/route 2>/dev/null)
  else
    # On the host — ask Docker for the bridge gateway
    GATEWAY=$(docker network inspect bridge \
      --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null)
  fi
  ISPTV_API_URL="http://${GATEWAY:-172.17.0.1}:7654"
fi
export ISPTV_API_URL

exec "$SCRIPT_DIR/src/isponsorblock/.venv/bin/python" \
     "$SCRIPT_DIR/src/isponsorblock/youtube_cli.py" "$@"
